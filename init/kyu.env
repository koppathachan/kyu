# Environment for the kyu systemd unit. Each variable has a matching flag; see
# https://github.com/koppathachan/kyu/blob/main/docs/architecture.md#configuration
#
# This file is configuration: a package upgrade leaves your edits in place.

# The kyu.storage.v1.Storage server this engine uses. Required — kyu has no
# default backend and will not start without one.
#KYU_STORAGE=127.0.0.1:50052

# Where kyu.v1.Kyu is served.
KYU_LISTEN=127.0.0.1:50051

#KYU_SWEEP_INTERVAL=1s
#KYU_SWEEP_INTERVAL_MAX=30s
#KYU_SCAN_LIMIT=100
#KYU_DISCOVERY_INTERVAL=30s
#KYU_NEGATIVE_CACHE_TTL=5s
